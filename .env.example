# YouTube Translation API - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# Server Configuration
# ==============================================
PORT=3001
FRONTEND_URL=http://localhost:3000

# ==============================================
# Groq API (for transcription/translation)
# ==============================================
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# ==============================================
# Clerk Authentication
# ==============================================
# Get your secret key from: https://dashboard.clerk.com/
# Go to: API Keys > Secret keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ==============================================
# Stripe Payments
# ==============================================
# Get your keys from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (starts with sk_test_ for test mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (starts with whsec_)
# Get this after creating a webhook endpoint in Stripe Dashboard
# Webhook URL: https://your-domain.com/api/webhook
# Events to listen for:
#   - checkout.session.completed
#   - customer.subscription.updated
#   - customer.subscription.deleted
#   - invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price ID for the subscription product
# Create a product in Stripe Dashboard > Products
# Then create a price ($5.99/month recommended)
# Copy the Price ID (starts with price_)
STRIPE_PRICE_ID=price_your_price_id_here

# ==============================================
# Lyrics Database (Optional)
# ==============================================
# These are optional - if not set, the app will always use Groq for transcription

# Musixmatch API Key (optional)
# Get from: https://developer.musixmatch.com/
# Free tier: 2,000 API calls per day
MUSIXMATCH_API_KEY=

# Enable web scraping for lyrics (optional)
# Set to 'true' to enable scraping from lyrics websites
# Default is disabled for legal/TOS reasons
ENABLE_LYRICS_SCRAPING=false
